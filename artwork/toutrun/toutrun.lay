<?xml version="1.0"?>
<mamelayout version="2">
    <element name="outrun_shifter" defstate="0">
        <image state="0" file="lo.png" />
        <image state="1" file="hi.png" />
    </element>

    <view name="Outrun Custom Shifter" screen_composite="1">
        <screen index="0">
            <bounds x="0" y="0" width="320" height="224" />
        </screen>

	<element ref="outrun_shifter" id="shifter" outputtag="shifter_output" blend="alpha">
            <bounds x="0" y="0" width="320" height="224" />
        </element>
    </view>
</mamelayout>
